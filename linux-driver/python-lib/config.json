{
  "_comment": "Nuvoton RGB daemon configuration",

  "mode": "cpu_temp",
  "update_interval_s": 2,
  "brightness": 1.0,

  "modes": {
    "cpu_temp": {
      "_comment": "Color tracks CPU temperature",
      "thresholds": [
        { "max": 50,  "color": [0,   0,   255] },
        { "max": 65,  "color": [0,   255, 128] },
        { "max": 75,  "color": [0,   255, 0  ] },
        { "max": 85,  "color": [255, 165, 0  ] },
        { "max": 999, "color": [255, 0,   0  ] }
      ]
    },
    "gpu_temp": {
      "_comment": "Color tracks GPU temperature",
      "thresholds": [
        { "max": 50,  "color": [0,   0,   255] },
        { "max": 65,  "color": [0,   255, 128] },
        { "max": 75,  "color": [0,   255, 0  ] },
        { "max": 85,  "color": [255, 165, 0  ] },
        { "max": 999, "color": [255, 0,   0  ] }
      ]
    },
    "cpu_usage": {
      "_comment": "Color tracks CPU usage percentage",
      "thresholds": [
        { "max": 20,  "color": [0,   0,   255] },
        { "max": 50,  "color": [0,   255, 0  ] },
        { "max": 80,  "color": [255, 165, 0  ] },
        { "max": 100, "color": [255, 0,   0  ] }
      ]
    },
    "gpu_usage": {
      "_comment": "Color tracks GPU usage percentage",
      "thresholds": [
        { "max": 20,  "color": [0,   0,   255] },
        { "max": 50,  "color": [0,   255, 0  ] },
        { "max": 80,  "color": [255, 165, 0  ] },
        { "max": 100, "color": [255, 0,   0  ] }
      ]
    },
    "static": {
      "_comment": "Fixed colour, no sensor input",
      "color": [0, 180, 255]
    },
    "fire": {
      "_comment": "Thermal demoscene: intensity from max(cpu_temp, gpu_temp)",
      "t_min": 45,
      "t_max": 90,
      "hot_at": 85
    },
    "vibe": {
      "_comment": "Auto mood: idle below idle_usage% for idle_samples reads -> Zzz",
      "idle_usage": 5,
      "idle_samples": 15
    },
    "off": {
      "_comment": "Turn LEDs off"
    }
  }
}
